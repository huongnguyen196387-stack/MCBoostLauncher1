<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MCBoost Launcher" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvBuild" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.1.2" android:textColor="@color:muted" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="More FPS • smoother gameplay • better control" android:textColor="@color:muted" android:textSize="14sp" />

        <LinearLayout android:id="@+id/minecraftCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
            <TextView android:id="@+id/tvInstall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Checking Minecraft…" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="@color:muted" android:textSize="14sp" />
        </LinearLayout>

        <Button android:id="@+id/btnPlay" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:text="▶  PLAY MINECRAFT" android:textAllCaps="false" android:textColor="#062012" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/bg_button" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Performance" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvPerfSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Balanced" android:textColor="@color:accent2" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <TextView android:id="@+id/btnPerformance" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="⚡  Performance profiles" android:textColor="@color/text" android:textSize="16sp" android:background="@drawable/bg_card" />
            <TextView android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="◎  Overlay • FPS • CPS • Zoom" android:textColor="@color/text" android:textSize="16sp" android:background="@drawable/bg_card" />
            <TextView android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="⚙  Permissions &amp; tools" android:textColor="@color/text" android:textSize="16sp" android:background="@drawable/bg_card" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="What is real on Android" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Thermal monitoring, battery-mode optimization, display refresh-rate reporting, overlay HUD, and Accessibility zoom can be implemented directly. Minecraft's internal renderer culling and FPS cap require an in-game engine module; this launcher does not fake them." android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
